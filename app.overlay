/ {
    aliases {
        led0 = &led_node;
        buz0 = &buzzer_node;
        step1 = &step_node;
        dir1 = &dir_node;
        enab1 = &enab_node;
        qdec0 = &qdec4;
    };

    my_outputs {
        compatible = "gpio-leds";
        led_node: led1 {
            gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
        };
        buzzer_node: buz1 {
            gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
        };
        dir_node: dir1 {
            gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
        };
    };
    my_pwm {
    compatible = "pwm-leds";
    step_node: step1 {
        pwms = <&pwm2 1 1000000 PWM_POLARITY_NORMAL>;
    };
};
    my_controls {
        compatible = "gpio-leds";
        enab_node: enab1 {
            gpios = <&gpioa 7 GPIO_ACTIVE_LOW>;
        };
    };

};

&i2c1 {
    status = "okay";
    lps22hb@5d {
        compatible = "st,lps22hb-press";
        reg = <0x5d>;
        label = "LPS22HB";
    };
};
&timers2 {
    status = "okay";
    pwm2: pwm {
        status = "okay";
        pinctrl-0 = <&tim2_ch1_pa0>;
        pinctrl-names = "default";
        #pwm-cells = <3>;
    };
};
&pinctrl {
    tim4_ch1_pb6: tim4_ch1_pb6 {
        pinmux = <STM32_PINMUX('B', 6, AF2)>;
    };

    tim4_ch2_pb7: tim4_ch2_pb7 {
        pinmux = <STM32_PINMUX('B', 7, AF2)>;
    };
};

&timers4 {
    status = "okay";
    st,prescaler = <0>;

    qdec4: qdec4 {
        compatible = "st,stm32-qdec";
        status = "okay";
        pinctrl-0 = <&tim4_ch1_pb6 &tim4_ch2_pb7>;
        pinctrl-names = "default";
        st,encoder-mode = <3>;
        st,counts-per-revolution = <2400>;
    };
};